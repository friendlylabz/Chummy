{
  "format": "chummy.loop",
  "version": 2,
  "name": "5 step recursive plan",
  "description": "Treats your message as a goal and tries to do it straight away, by writing or with tools. Anything too big is broken into 5 or fewer smaller steps, and each step is tried the same way, breadth-first. Every result and plan is shown, and added to one running exchange.",
  "limits": {
    "max_steps": 800,
    "max_llm_calls": 60,
    "max_tool_calls": 30
  },
  "blocks": [
    {
      "id": "goal",
      "type": "input",
      "label": "Goal",
      "position": {
        "x": 0,
        "y": 0
      },
      "params": {}
    },
    {
      "id": "goal_text",
      "type": "combine",
      "label": "Goal text",
      "position": {
        "x": 260,
        "y": -180
      },
      "params": {
        "inputs": 1,
        "format": "Goal: _INPUT1_"
      }
    },
    {
      "id": "start",
      "type": "exchange",
      "label": "Running exchange",
      "position": {
        "x": 520,
        "y": -180
      },
      "params": {
        "system": "You are working toward the user's goal one task at a time. Keep every answer short and concrete.",
        "roles": [
          "user"
        ]
      }
    },
    {
      "id": "queue",
      "type": "forward",
      "label": "Tasks to do",
      "position": {
        "x": 520,
        "y": 80
      },
      "params": {}
    },
    {
      "id": "pair",
      "type": "augment",
      "label": "Next task",
      "position": {
        "x": 780,
        "y": 0
      },
      "params": {
        "role": "user",
        "format": "Task: _INPUT_"
      }
    },
    {
      "id": "attempt",
      "type": "function",
      "label": "Attempt the task",
      "position": {
        "x": 1040,
        "y": 0
      },
      "params": {
        "function": "attempt"
      }
    },
    {
      "id": "show_result",
      "type": "output",
      "label": "Show result",
      "position": {
        "x": 1300,
        "y": -180
      },
      "params": {}
    },
    {
      "id": "plan",
      "type": "function",
      "label": "Plan smaller steps",
      "position": {
        "x": 1300,
        "y": 120
      },
      "params": {
        "function": "break_down"
      }
    },
    {
      "id": "show_plan",
      "type": "output",
      "label": "Show plan",
      "position": {
        "x": 1560,
        "y": 120
      },
      "params": {}
    },
    {
      "id": "more",
      "type": "for_each",
      "label": "Up to 5 steps",
      "position": {
        "x": 1560,
        "y": 320
      },
      "params": {
        "limit": 5
      }
    }
  ],
  "links": [
    {
      "from": {
        "block": "goal",
        "port": "out"
      },
      "to": {
        "block": "goal_text",
        "port": "in1"
      }
    },
    {
      "from": {
        "block": "goal",
        "port": "out"
      },
      "to": {
        "block": "queue",
        "port": "in"
      }
    },
    {
      "from": {
        "block": "goal_text",
        "port": "out"
      },
      "to": {
        "block": "start",
        "port": "in"
      }
    },
    {
      "from": {
        "block": "start",
        "port": "out"
      },
      "to": {
        "block": "pair",
        "port": "exchange"
      }
    },
    {
      "from": {
        "block": "queue",
        "port": "out"
      },
      "to": {
        "block": "pair",
        "port": "in"
      }
    },
    {
      "from": {
        "block": "pair",
        "port": "out"
      },
      "to": {
        "block": "attempt",
        "port": "exchange"
      }
    },
    {
      "from": {
        "block": "attempt",
        "port": "message"
      },
      "to": {
        "block": "show_result",
        "port": "in"
      }
    },
    {
      "from": {
        "block": "attempt",
        "port": "done"
      },
      "to": {
        "block": "pair",
        "port": "exchange"
      }
    },
    {
      "from": {
        "block": "attempt",
        "port": "breakdown"
      },
      "to": {
        "block": "plan",
        "port": "exchange"
      }
    },
    {
      "from": {
        "block": "plan",
        "port": "message"
      },
      "to": {
        "block": "show_plan",
        "port": "in"
      }
    },
    {
      "from": {
        "block": "plan",
        "port": "after"
      },
      "to": {
        "block": "pair",
        "port": "exchange"
      }
    },
    {
      "from": {
        "block": "plan",
        "port": "steps"
      },
      "to": {
        "block": "more",
        "port": "in"
      }
    },
    {
      "from": {
        "block": "more",
        "port": "out"
      },
      "to": {
        "block": "queue",
        "port": "in"
      }
    }
  ],
  "functions": [
    {
      "id": "attempt",
      "name": "Attempt the task",
      "description": "The model tries the task, calling tools as often as it needs. If it says the task is too big, the exchange goes out of Breakdown instead.",
      "inputs": [
        {
          "name": "exchange",
          "label": "Exchange",
          "to": {
            "block": "entry",
            "port": "in"
          }
        }
      ],
      "outputs": [
        {
          "name": "message",
          "label": "Result message",
          "from": {
            "block": "message",
            "port": "out"
          }
        },
        {
          "name": "done",
          "label": "Exchange with result",
          "from": {
            "block": "add_result",
            "port": "out"
          }
        },
        {
          "name": "breakdown",
          "label": "Breakdown",
          "from": {
            "block": "to_plan",
            "port": "out"
          }
        }
      ],
      "blocks": [
        {
          "id": "entry",
          "type": "forward",
          "label": "Exchange",
          "position": {
            "x": 0,
            "y": 0
          },
          "params": {}
        },
        {
          "id": "work",
          "type": "llm",
          "label": "Try the task",
          "position": {
            "x": 260,
            "y": 0
          },
          "params": {
            "system": "Do the user's latest task now. Use a tool if it helps. If you can do it, give the result in a few sentences. If it is too big to finish in one go, reply with only: TOO BIG",
            "max_tokens": 800,
            "tools": [
              "read_file",
              "write_file",
              "list_files",
              "search_files",
              "fetch_page",
              "calculator",
              "current_time"
            ],
            "retries": 2
          }
        },
        {
          "id": "run",
          "type": "run_tool",
          "label": "Run tool",
          "position": {
            "x": 520,
            "y": 200
          },
          "params": {
            "max_result_chars": 4000
          }
        },
        {
          "id": "which",
          "type": "read_exchange",
          "label": "Which task",
          "position": {
            "x": 260,
            "y": -200
          },
          "params": {
            "role": "user"
          }
        },
        {
          "id": "big_answer",
          "type": "branch",
          "label": "Too big? (answer)",
          "position": {
            "x": 780,
            "y": 0
          },
          "params": {
            "pattern": "(?i)^\\W*too\\s*big"
          }
        },
        {
          "id": "big_exchange",
          "type": "branch",
          "label": "Too big? (exchange)",
          "position": {
            "x": 780,
            "y": 200
          },
          "params": {
            "pattern": "(?i)^\\W*too\\s*big"
          }
        },
        {
          "id": "add_result",
          "type": "augment",
          "label": "Add result",
          "position": {
            "x": 1300,
            "y": 100
          },
          "params": {
            "role": "assistant",
            "format": "_INPUT_"
          }
        },
        {
          "id": "message",
          "type": "combine",
          "label": "Result message",
          "position": {
            "x": 1300,
            "y": -150
          },
          "params": {
            "inputs": 2,
            "format": "**✓ _INPUT1_**\n\n_INPUT2_"
          }
        },
        {
          "id": "to_plan",
          "type": "forward",
          "label": "Needs a plan",
          "position": {
            "x": 1300,
            "y": 350
          },
          "params": {}
        }
      ],
      "links": [
        {
          "from": {
            "block": "entry",
            "port": "out"
          },
          "to": {
            "block": "work",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "work",
            "port": "tool"
          },
          "to": {
            "block": "run",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "run",
            "port": "out"
          },
          "to": {
            "block": "work",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "entry",
            "port": "out"
          },
          "to": {
            "block": "which",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "work",
            "port": "out"
          },
          "to": {
            "block": "big_answer",
            "port": "value"
          }
        },
        {
          "from": {
            "block": "work",
            "port": "out"
          },
          "to": {
            "block": "big_answer",
            "port": "test"
          }
        },
        {
          "from": {
            "block": "entry",
            "port": "out"
          },
          "to": {
            "block": "big_exchange",
            "port": "value"
          }
        },
        {
          "from": {
            "block": "work",
            "port": "out"
          },
          "to": {
            "block": "big_exchange",
            "port": "test"
          }
        },
        {
          "from": {
            "block": "big_exchange",
            "port": "yes"
          },
          "to": {
            "block": "to_plan",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "which",
            "port": "last"
          },
          "to": {
            "block": "message",
            "port": "in1"
          }
        },
        {
          "from": {
            "block": "big_answer",
            "port": "no"
          },
          "to": {
            "block": "add_result",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "big_exchange",
            "port": "no"
          },
          "to": {
            "block": "add_result",
            "port": "exchange"
          }
        },
        {
          "from": {
            "block": "big_answer",
            "port": "no"
          },
          "to": {
            "block": "message",
            "port": "in2"
          }
        }
      ]
    },
    {
      "id": "break_down",
      "name": "Plan smaller steps",
      "description": "Plans 5 or fewer smaller steps for a task that's too big.",
      "inputs": [
        {
          "name": "exchange",
          "label": "Exchange",
          "to": {
            "block": "entry",
            "port": "in"
          }
        }
      ],
      "outputs": [
        {
          "name": "message",
          "label": "Plan message",
          "from": {
            "block": "message",
            "port": "out"
          }
        },
        {
          "name": "after",
          "label": "Exchange with plan",
          "from": {
            "block": "after",
            "port": "out"
          }
        },
        {
          "name": "steps",
          "label": "Steps",
          "from": {
            "block": "parse",
            "port": "group1"
          }
        }
      ],
      "blocks": [
        {
          "id": "entry",
          "type": "forward",
          "label": "Exchange",
          "position": {
            "x": 0,
            "y": 0
          },
          "params": {}
        },
        {
          "id": "which",
          "type": "read_exchange",
          "label": "Which task",
          "position": {
            "x": 260,
            "y": 200
          },
          "params": {
            "role": "user"
          }
        },
        {
          "id": "ask",
          "type": "augment",
          "label": "Ask for smaller steps",
          "position": {
            "x": 520,
            "y": 0
          },
          "params": {
            "role": "user",
            "format": "_INPUT_\n\nThis is too big to do in one go. Break it into 5 or fewer smaller steps, as broad or as narrow as each needs to be. Write only the steps, one per line, numbered like:\n1. First step\n2. Second step"
          }
        },
        {
          "id": "sub",
          "type": "llm",
          "label": "Plan smaller steps",
          "position": {
            "x": 780,
            "y": 0
          },
          "params": {
            "temperature": 0.3,
            "max_tokens": 400
          }
        },
        {
          "id": "plan",
          "type": "forward",
          "label": "The plan",
          "position": {
            "x": 1300,
            "y": 0
          },
          "params": {}
        },
        {
          "id": "parse",
          "type": "capture",
          "label": "Steps",
          "position": {
            "x": 1560,
            "y": 0
          },
          "params": {
            "pattern": "(?m)^\\s*\\d+[.)]\\s*(.+?)\\s*$"
          }
        },
        {
          "id": "message",
          "type": "combine",
          "label": "Plan message",
          "position": {
            "x": 1560,
            "y": 200
          },
          "params": {
            "inputs": 2,
            "format": "**Breaking down _INPUT1_**\n\n_INPUT2_"
          }
        },
        {
          "id": "after",
          "type": "augment",
          "label": "Add the plan",
          "position": {
            "x": 1560,
            "y": -200
          },
          "params": {
            "role": "assistant",
            "format": "I broke this task into smaller steps:\n_INPUT_"
          }
        }
      ],
      "links": [
        {
          "from": {
            "block": "entry",
            "port": "out"
          },
          "to": {
            "block": "ask",
            "port": "exchange"
          }
        },
        {
          "from": {
            "block": "entry",
            "port": "out"
          },
          "to": {
            "block": "which",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "which",
            "port": "last"
          },
          "to": {
            "block": "ask",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "ask",
            "port": "out"
          },
          "to": {
            "block": "sub",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "plan",
            "port": "out"
          },
          "to": {
            "block": "parse",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "plan",
            "port": "out"
          },
          "to": {
            "block": "message",
            "port": "in2"
          }
        },
        {
          "from": {
            "block": "plan",
            "port": "out"
          },
          "to": {
            "block": "after",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "which",
            "port": "last"
          },
          "to": {
            "block": "message",
            "port": "in1"
          }
        },
        {
          "from": {
            "block": "entry",
            "port": "out"
          },
          "to": {
            "block": "after",
            "port": "exchange"
          }
        },
        {
          "from": {
            "block": "sub",
            "port": "out"
          },
          "to": {
            "block": "plan",
            "port": "in"
          }
        }
      ]
    }
  ]
}
