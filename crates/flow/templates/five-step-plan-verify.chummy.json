{
  "format": "chummy.loop",
  "version": 1,
  "name": "5 step recursive plan verify",
  "description": "Treats your message as a goal and tries to do it straight away, by writing or with tools. Anything too big is broken into 5 or fewer smaller steps, and each step is tried the same way, breadth-first. Every result and plan is shown, and added to one running exchange. Each result and plan is also checked: the model writes a yes/no question for it and answers it. Results that fail are broken down; plans that fail are made again once. Slower, but more careful.",
  "limits": {
    "max_steps": 1500,
    "max_llm_calls": 120,
    "max_tool_calls": 40
  },
  "blocks": [
    {
      "id": "goal",
      "type": "input",
      "label": "Goal",
      "position": {
        "x": 0,
        "y": 0
      },
      "params": {}
    },
    {
      "id": "goal_text",
      "type": "combine",
      "label": "Goal text",
      "position": {
        "x": 260,
        "y": -180
      },
      "params": {
        "inputs": 1,
        "format": "Goal: _INPUT1_"
      }
    },
    {
      "id": "start",
      "type": "exchange",
      "label": "Running exchange",
      "position": {
        "x": 520,
        "y": -180
      },
      "params": {
        "system": "You are working toward the user's goal one task at a time. Keep every answer short and concrete.",
        "roles": [
          "user"
        ]
      }
    },
    {
      "id": "queue",
      "type": "forward",
      "label": "Tasks to do",
      "position": {
        "x": 520,
        "y": 80
      },
      "params": {}
    },
    {
      "id": "pair",
      "type": "augment",
      "label": "Next task",
      "position": {
        "x": 780,
        "y": 0
      },
      "params": {
        "role": "user",
        "format": "Task: _INPUT_"
      }
    },
    {
      "id": "attempt",
      "type": "function",
      "label": "Attempt the task",
      "position": {
        "x": 1040,
        "y": 0
      },
      "params": {
        "function": "attempt"
      }
    },
    {
      "id": "show_result",
      "type": "output",
      "label": "Show result",
      "position": {
        "x": 1300,
        "y": -180
      },
      "params": {}
    },
    {
      "id": "plan",
      "type": "function",
      "label": "Plan smaller steps",
      "position": {
        "x": 1300,
        "y": 120
      },
      "params": {
        "function": "break_down"
      }
    },
    {
      "id": "show_plan",
      "type": "output",
      "label": "Show plan",
      "position": {
        "x": 1560,
        "y": 120
      },
      "params": {}
    },
    {
      "id": "more",
      "type": "for_each",
      "label": "Up to 5 steps",
      "position": {
        "x": 1560,
        "y": 320
      },
      "params": {
        "limit": 5
      }
    }
  ],
  "links": [
    {
      "from": {
        "block": "goal",
        "port": "out"
      },
      "to": {
        "block": "goal_text",
        "port": "in1"
      }
    },
    {
      "from": {
        "block": "goal",
        "port": "out"
      },
      "to": {
        "block": "queue",
        "port": "in"
      }
    },
    {
      "from": {
        "block": "goal_text",
        "port": "out"
      },
      "to": {
        "block": "start",
        "port": "in"
      }
    },
    {
      "from": {
        "block": "start",
        "port": "out"
      },
      "to": {
        "block": "pair",
        "port": "exchange"
      }
    },
    {
      "from": {
        "block": "queue",
        "port": "out"
      },
      "to": {
        "block": "pair",
        "port": "in"
      }
    },
    {
      "from": {
        "block": "pair",
        "port": "out"
      },
      "to": {
        "block": "attempt",
        "port": "exchange"
      }
    },
    {
      "from": {
        "block": "attempt",
        "port": "message"
      },
      "to": {
        "block": "show_result",
        "port": "in"
      }
    },
    {
      "from": {
        "block": "attempt",
        "port": "done"
      },
      "to": {
        "block": "pair",
        "port": "exchange"
      }
    },
    {
      "from": {
        "block": "attempt",
        "port": "breakdown"
      },
      "to": {
        "block": "plan",
        "port": "exchange"
      }
    },
    {
      "from": {
        "block": "plan",
        "port": "message"
      },
      "to": {
        "block": "show_plan",
        "port": "in"
      }
    },
    {
      "from": {
        "block": "plan",
        "port": "after"
      },
      "to": {
        "block": "pair",
        "port": "exchange"
      }
    },
    {
      "from": {
        "block": "plan",
        "port": "steps"
      },
      "to": {
        "block": "more",
        "port": "in"
      }
    },
    {
      "from": {
        "block": "more",
        "port": "out"
      },
      "to": {
        "block": "queue",
        "port": "in"
      }
    }
  ],
  "functions": [
    {
      "id": "verify",
      "name": "Verify",
      "description": "Writes a yes/no check question for an answer, then asks the model that question about it. Passed sends the answer on; Failed sends the reason.",
      "inputs": [
        {
          "name": "request",
          "label": "Request",
          "to": {
            "block": "req",
            "port": "in"
          }
        },
        {
          "name": "answer",
          "label": "Answer",
          "to": {
            "block": "ans",
            "port": "in"
          }
        }
      ],
      "outputs": [
        {
          "name": "passed",
          "label": "Passed",
          "from": {
            "block": "pass",
            "port": "yes"
          }
        },
        {
          "name": "failed",
          "label": "Failed (reason)",
          "from": {
            "block": "why",
            "port": "no"
          }
        },
        {
          "name": "verdict",
          "label": "Verdict",
          "from": {
            "block": "check",
            "port": "out"
          }
        }
      ],
      "blocks": [
        {
          "id": "req",
          "type": "forward",
          "label": "Request",
          "position": {
            "x": 0,
            "y": 0
          },
          "params": {}
        },
        {
          "id": "ans",
          "type": "forward",
          "label": "Answer",
          "position": {
            "x": 0,
            "y": 200
          },
          "params": {}
        },
        {
          "id": "ask_q",
          "type": "combine",
          "label": "Ask for a check",
          "position": {
            "x": 260,
            "y": 0
          },
          "params": {
            "inputs": 2,
            "format": "Request: _INPUT1_\n\nAnswer: _INPUT2_\n\nWrite one yes-or-no question that checks this answer against the request, such as \"Does this answer make sense given the request?\" Write only the question."
          }
        },
        {
          "id": "question",
          "type": "llm",
          "label": "Write a check question",
          "position": {
            "x": 520,
            "y": 0
          },
          "params": {
            "system": "Write one short yes-or-no question.",
            "temperature": 0.2,
            "max_tokens": 80
          }
        },
        {
          "id": "ask_c",
          "type": "combine",
          "label": "Ask the check",
          "position": {
            "x": 780,
            "y": 100
          },
          "params": {
            "inputs": 3,
            "format": "Request: _INPUT1_\n\nAnswer: _INPUT2_\n\nQuestion: _INPUT3_\n\nAnswer the question about the answer above. Start with YES or NO, then give one short reason."
          }
        },
        {
          "id": "check",
          "type": "llm",
          "label": "Answer the check",
          "position": {
            "x": 1040,
            "y": 100
          },
          "params": {
            "system": "Answer YES or NO first, then give one short reason.",
            "temperature": 0.0,
            "max_tokens": 80
          }
        },
        {
          "id": "pass",
          "type": "branch",
          "label": "Passed?",
          "position": {
            "x": 1300,
            "y": 200
          },
          "params": {
            "pattern": "(?i)^\\W*yes"
          }
        },
        {
          "id": "why",
          "type": "branch",
          "label": "Reason if not",
          "position": {
            "x": 1300,
            "y": 0
          },
          "params": {
            "pattern": "(?i)^\\W*yes"
          }
        }
      ],
      "links": [
        {
          "from": {
            "block": "req",
            "port": "out"
          },
          "to": {
            "block": "ask_q",
            "port": "in1"
          }
        },
        {
          "from": {
            "block": "ans",
            "port": "out"
          },
          "to": {
            "block": "ask_q",
            "port": "in2"
          }
        },
        {
          "from": {
            "block": "ask_q",
            "port": "out"
          },
          "to": {
            "block": "question",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "req",
            "port": "out"
          },
          "to": {
            "block": "ask_c",
            "port": "in1"
          }
        },
        {
          "from": {
            "block": "ans",
            "port": "out"
          },
          "to": {
            "block": "ask_c",
            "port": "in2"
          }
        },
        {
          "from": {
            "block": "question",
            "port": "out"
          },
          "to": {
            "block": "ask_c",
            "port": "in3"
          }
        },
        {
          "from": {
            "block": "ask_c",
            "port": "out"
          },
          "to": {
            "block": "check",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "ans",
            "port": "out"
          },
          "to": {
            "block": "pass",
            "port": "value"
          }
        },
        {
          "from": {
            "block": "check",
            "port": "out"
          },
          "to": {
            "block": "pass",
            "port": "test"
          }
        },
        {
          "from": {
            "block": "check",
            "port": "out"
          },
          "to": {
            "block": "why",
            "port": "value"
          }
        },
        {
          "from": {
            "block": "check",
            "port": "out"
          },
          "to": {
            "block": "why",
            "port": "test"
          }
        }
      ]
    },
    {
      "id": "attempt",
      "name": "Attempt the task",
      "description": "The model tries the task, calling tools as often as it needs, and checks its result with Verify. If it says the task is too big, or the result fails its check, the exchange goes out of Breakdown instead.",
      "inputs": [
        {
          "name": "exchange",
          "label": "Exchange",
          "to": {
            "block": "entry",
            "port": "in"
          }
        }
      ],
      "outputs": [
        {
          "name": "message",
          "label": "Result message",
          "from": {
            "block": "message",
            "port": "out"
          }
        },
        {
          "name": "done",
          "label": "Exchange with result",
          "from": {
            "block": "add_result",
            "port": "out"
          }
        },
        {
          "name": "breakdown",
          "label": "Breakdown",
          "from": {
            "block": "to_plan",
            "port": "out"
          }
        }
      ],
      "blocks": [
        {
          "id": "entry",
          "type": "forward",
          "label": "Exchange",
          "position": {
            "x": 0,
            "y": 0
          },
          "params": {}
        },
        {
          "id": "work",
          "type": "llm",
          "label": "Try the task",
          "position": {
            "x": 260,
            "y": 0
          },
          "params": {
            "system": "Do the user's latest task now. Use a tool if it helps. If you can do it, give the result in a few sentences. If it is too big to finish in one go, reply with only: TOO BIG",
            "max_tokens": 800,
            "tools": [
              "read_file",
              "write_file",
              "list_files",
              "search_files",
              "fetch_page",
              "calculator",
              "current_time"
            ],
            "retries": 2
          }
        },
        {
          "id": "run",
          "type": "run_tool",
          "label": "Run tool",
          "position": {
            "x": 520,
            "y": 200
          },
          "params": {
            "max_result_chars": 4000
          }
        },
        {
          "id": "which",
          "type": "read_exchange",
          "label": "Which task",
          "position": {
            "x": 260,
            "y": -200
          },
          "params": {
            "role": "user"
          }
        },
        {
          "id": "big_answer",
          "type": "branch",
          "label": "Too big? (answer)",
          "position": {
            "x": 780,
            "y": 0
          },
          "params": {
            "pattern": "(?i)^\\W*too\\s*big"
          }
        },
        {
          "id": "big_exchange",
          "type": "branch",
          "label": "Too big? (exchange)",
          "position": {
            "x": 780,
            "y": 200
          },
          "params": {
            "pattern": "(?i)^\\W*too\\s*big"
          }
        },
        {
          "id": "add_result",
          "type": "augment",
          "label": "Add result",
          "position": {
            "x": 1300,
            "y": 100
          },
          "params": {
            "role": "assistant",
            "format": "_INPUT_"
          }
        },
        {
          "id": "message",
          "type": "combine",
          "label": "Result message",
          "position": {
            "x": 1300,
            "y": -150
          },
          "params": {
            "inputs": 2,
            "format": "**✓ _INPUT1_**\n\n_INPUT2_"
          }
        },
        {
          "id": "to_plan",
          "type": "forward",
          "label": "Needs a plan",
          "position": {
            "x": 1300,
            "y": 350
          },
          "params": {}
        },
        {
          "id": "verify",
          "type": "function",
          "label": "Verify the result",
          "position": {
            "x": 1040,
            "y": -50
          },
          "params": {
            "function": "verify"
          }
        },
        {
          "id": "checked",
          "type": "branch",
          "label": "Passed the check?",
          "position": {
            "x": 1040,
            "y": 200
          },
          "params": {
            "pattern": "(?i)^\\W*yes"
          }
        },
        {
          "id": "note",
          "type": "augment",
          "label": "Note the failed check",
          "position": {
            "x": 1300,
            "y": 500
          },
          "params": {
            "role": "assistant",
            "format": "My attempt didn't pass this check: _INPUT_"
          }
        }
      ],
      "links": [
        {
          "from": {
            "block": "entry",
            "port": "out"
          },
          "to": {
            "block": "work",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "work",
            "port": "tool"
          },
          "to": {
            "block": "run",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "run",
            "port": "out"
          },
          "to": {
            "block": "work",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "entry",
            "port": "out"
          },
          "to": {
            "block": "which",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "work",
            "port": "out"
          },
          "to": {
            "block": "big_answer",
            "port": "value"
          }
        },
        {
          "from": {
            "block": "work",
            "port": "out"
          },
          "to": {
            "block": "big_answer",
            "port": "test"
          }
        },
        {
          "from": {
            "block": "entry",
            "port": "out"
          },
          "to": {
            "block": "big_exchange",
            "port": "value"
          }
        },
        {
          "from": {
            "block": "work",
            "port": "out"
          },
          "to": {
            "block": "big_exchange",
            "port": "test"
          }
        },
        {
          "from": {
            "block": "big_exchange",
            "port": "yes"
          },
          "to": {
            "block": "to_plan",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "which",
            "port": "last"
          },
          "to": {
            "block": "message",
            "port": "in1"
          }
        },
        {
          "from": {
            "block": "which",
            "port": "last"
          },
          "to": {
            "block": "verify",
            "port": "request"
          }
        },
        {
          "from": {
            "block": "big_answer",
            "port": "no"
          },
          "to": {
            "block": "verify",
            "port": "answer"
          }
        },
        {
          "from": {
            "block": "big_exchange",
            "port": "no"
          },
          "to": {
            "block": "checked",
            "port": "value"
          }
        },
        {
          "from": {
            "block": "verify",
            "port": "verdict"
          },
          "to": {
            "block": "checked",
            "port": "test"
          }
        },
        {
          "from": {
            "block": "checked",
            "port": "yes"
          },
          "to": {
            "block": "add_result",
            "port": "exchange"
          }
        },
        {
          "from": {
            "block": "verify",
            "port": "passed"
          },
          "to": {
            "block": "add_result",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "verify",
            "port": "passed"
          },
          "to": {
            "block": "message",
            "port": "in2"
          }
        },
        {
          "from": {
            "block": "checked",
            "port": "no"
          },
          "to": {
            "block": "note",
            "port": "exchange"
          }
        },
        {
          "from": {
            "block": "verify",
            "port": "failed"
          },
          "to": {
            "block": "note",
            "port": "in"
          }
        },
        {
          "from": {
            "block": "note",
            "port": "out"
          },
          "to": {
            "block": "to_plan",
            "port": "in"
          }
        }
      ]
    },
    {
      "id": "break_down",
      "name": "Plan smaller steps",
      "description": "Plans 5 or fewer smaller steps for a task that's too big, checks the plan with Verify, and plans once more, with the reason, if it fails.",
      "inputs": [
        {
          "name": "exchange",
          "label": "Exchange",
          "to": {
            "block": "entry",
            "port": "in"
          }
        }
      ],
      "outputs": [
        {
          "name": "message",
          "label": "Plan message",
          "from": {
            "block": "message",
            "port": "out"
          }
        },
        {
          "name": "after",
          "label": "Exchange with plan",
          "from": {
            "block": "after",
            "port": "out"
          }
        },
        {
          "name": "steps",
          "label": "Steps",
          "from": {
            "block": "parse",
            "port": "group1"
          }
        }
      ],
      "blocks": [
        {
          "id": "entry",
          "type": "forward",
          "label": "Exchange",
          "position": {
            "x": 0,
            "y": 0
          },
          "params": {}
        },
        {
          "id": "which",
          "type": "read_exchange",
          "label": "Which task",
          "position": {
            "x": 260,
            "y": 200
          },
          "params": {
            "role": "user"
          }
        },
        {
          "id": "ask",
          "type": "augment",
          "label": "Ask for smaller steps",
          "position": {
            "x": 520,
            "y": 0
          },
          "params": {
            "role": "user",
            "format": "_INPUT_\n\nThis is too big to do in one go. Break it into 5 or fewer smaller steps, as broad or as narrow as each needs to be. Write only the steps, one per line, numbered like:\n1. First step\n2. Second step"
          }
        },
        {
          "id": "sub",
          "type": "llm",
          "label": "Plan smaller steps",
          "position": {
            "x": 780,
            "y": 0
          },
          "params": {
            "temperature": 0.3,
            "max_tokens": 400
          }
        },
        {
          "id": "plan",
          "type": "forward",
          "label": "The plan",
          "position": {
            "x": 1300,
            "y": 0
          },
          "params": {}
        },
        {
          "id": "parse",
          "type": "capture",
          "label": "Steps",
          "position": {
            "x": 1560,
            "y": 0
          },
          "params": {
            "pattern": "(?m)^\\s*\\d+[.)]\\s*(.+?)\\s*$"
          }
        },
        {
          "id": "message",
          "type": "combine",
          "label": "Plan message",
          "position": {
            "x": 1560,
            "y": 200
          },
          "params": {
            "inputs": 2,
            "format": "**Breaking down _INPUT1_**\n\n_INPUT2_"
          }
        },
        {
          "id": "after",
          "type": "augment",
          "label": "Add the plan",
          "position": {
            "x": 1560,
            "y": -200
          },
          "params": {
            "role": "assistant",
            "format": "I broke this task into smaller steps:\n_INPUT_"
          }
        },
        {
          "id": "verify",
          "type": "function",
          "label": "Verify the plan",
          "position": {
            "x": 1040,
            "y": 0
          },
          "params": {
            "function": "verify"
          }
        },
        {
          "id": "with_plan",
          "type": "augment",
          "label": "Keep the first plan",
          "position": {
            "x": 1040,
            "y": 250
          },
          "params": {
            "role": "assistant",
            "format": "_INPUT_"
          }
        },
        {
          "id": "checked",
          "type": "branch",
          "label": "Passed the check?",
          "position": {
            "x": 1300,
            "y": 250
          },
          "params": {
            "pattern": "(?i)^\\W*yes"
          }
