{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "scheduler",
  "description": "Scheduler window: jobs, their schedules and runs, and their questions.",
  "windows": [
    "scheduler"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-settings",
    "allow-open-window",
    "allow-setup-status",
    "allow-list-jobs",
    "allow-save-job",
    "allow-delete-job",
    "allow-set-job-enabled",
    "allow-run-job-now",
    "allow-stop-job",
    "allow-job-history",
    "allow-set-jobs-paused",
    "allow-import-job",
    "allow-export-job",
    "allow-list-loops",
    "allow-list-asks",
    "allow-answer-ask",
    "allow-list-runs",
    "allow-stop-run"
  ]
}
