{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main chat window: chat with agents, runs, opening windows, theme.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-setup-status",
    "allow-open-window",
    "allow-get-settings",
    "allow-set-theme",
    "allow-set-active-agent",
    "allow-get-chat",
    "allow-clear-chat",
    "allow-send-message",
    "allow-stop-run",
    "allow-list-runs"
  ]
}
