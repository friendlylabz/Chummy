{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main chat window: chat with agents, runs, opening windows, theme.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-setup-status",
    "allow-open-window",
    "allow-get-settings",
    "allow-read-run-log",
    "allow-block-catalog",
    "allow-add-recommended-loop",
    "allow-set-theme",
    "allow-set-active-agent",
    "allow-get-chat",
    "allow-list-chats",
    "allow-new-chat",
    "allow-set-active-chat",
    "allow-delete-chat",
    "allow-delete-chat-message",
    "allow-restore-chat-message",
    "allow-send-message",
    "allow-stop-run",
    "allow-pause-run",
    "allow-resume-run",
    "allow-discard-paused",
    "allow-list-paused",
    "allow-list-runs",
    "allow-run-pane",
    "allow-recent-runs",
    "allow-list-asks",
    "allow-answer-ask",
    "allow-close-activity",
    "allow-close-choice",
    "allow-log-key-status",
    "allow-open-link"
  ]
}
