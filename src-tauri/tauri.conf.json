{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chummy",
  "version": "0.1.0",
  "identifier": "com.friendlylabz.chummy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chummy",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 440,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; worker-src 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A minimalist, configurable agent harness.",
    "license": "MIT",
    "publisher": "friendlylabz",
    "copyright": "\u00a9 2026 friendlylabz",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
