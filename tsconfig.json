{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["svelte", "vite/client"],
    "paths": {
      "$lib/*": ["./ui/src/lib/*"],
      "$theme/*": ["./ui/src/theme/*"]
    }
  },
  "include": ["ui/src/**/*.ts", "ui/src/**/*.svelte"]
}
